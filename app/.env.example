# Copie este arquivo para ".env.local" (na mesma pasta app/) e preencha.
# O .env.local NÃO vai para o GitHub (está no .gitignore) — nunca publique sua chave.

# Endereço do back-end Spring Boot
BACKEND_URL=http://localhost:8080

# Chave GRATUITA do Google AI Studio: https://aistudio.google.com/apikey
# Usada pelo chatbot e pela triagem "O que você tem?".
# Sem essa chave, o chatbot usa só o FAQ do back-end e a triagem usa só as regras de segurança.
GEMINI_API_KEY=

# (opcional) modelo do Gemini. Se não existir, o sistema tenta gemini-2.5-flash.
GEMINI_MODEL=gemini-3.5-flash

# Alternativa GRATUITA ao Gemini (sem cartão): https://console.groq.com/keys
# Use se não conseguir gerar a chave do Gemini. Se as duas existirem, o Gemini tem prioridade.
GROQ_API_KEY=
# (opcional) modelo do Groq. Lista atual: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
